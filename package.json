{
  "name": "bspace-sdlc-app",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:desktop": "pnpm --filter @bspace-sdlc-app/desktop tauri dev --config src-tauri/tauri.dev.conf.json",
    "version:set": "node scripts/version.mjs",
    "usage": "node scripts/usage-report.mjs",
    "tokens": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check",
    "buma:pull": "node scripts/buma-pull.mjs",
    "skills:sync": "node scripts/sync-sdlc-skills.mjs"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4"
  },
  "author": "p-rama.msugiyanto"
}
